---
// HeroContractor.astro
// High-fidelity contractor landing page hero.
// Split layout with copy and benefit bullets on the left, and a
// high-converting floating estimate request form card on the right.
// Colors normalized from the library default (hardcoded red) to this
// project's primary/accent tokens per the Daystar "reuse and
// customize" rule, and the form now submits to Web3Forms directly.
import contentData from '../data/content.json';
import businessData from '../data/business.json';

const WEB3FORMS_ACCESS_KEY = 'YOUR_WEB3FORMS_ACCESS_KEY';

interface Props {
  badgeOverride?: string;
  headingOverride?: string;
  subtitleOverride?: string;
  bgImageOverride?: string;
  formTitle?: string;
}

const {
  badgeOverride,
  headingOverride,
  subtitleOverride,
  bgImageOverride,
  formTitle = 'GET A FREE ESTIMATE'
} = Astro.props;

const data = contentData.home?.heroContractor;

const badge = badgeOverride || data?.badge || "NASHVILLE'S BEST RATINGS";
const heading = headingOverride || data?.title || 'Pest Control in Nashville, TN';
const subtitle = subtitleOverride || data?.subtitle || 'Get professional, eco-friendly protection for your family. Safe, reliable, and guaranteed results.';
const bgImage = bgImageOverride || data?.bgImage || 'https://images.unsplash.com/photo-1558402529-d2638a7023e9?auto=format&fit=crop&w=1920&q=80';

const defaultBullets = [
  'Family Owned & Operated',
  'Licensed, Bonded & Insured',
  '100% Satisfaction Guarantee'
];
const bullets = data?.bullets || defaultBullets;
---

<section id="get-quote" class="relative min-h-[80vh] flex items-center justify-start text-white overflow-hidden py-24 select-none bg-neutral-950 border-b-4 border-primary">

  <!-- Backdrop Image & Overlay Layer -->
  <div class="absolute inset-0 z-0">
    <img
      src={bgImage}
      alt="Recently installed garage doors by Summers Garage Door Service"
      class="w-full h-full object-cover opacity-40"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-neutral-950 via-neutral-950/85 to-neutral-950/40"></div>
  </div>

  <div class="container mx-auto px-6 max-w-6.5xl relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

    <!-- Left Column: Content & Checkmarks -->
    <div class="lg:col-span-7 space-y-6 text-left">
      {badge && (
        <span class="text-xs font-bold uppercase tracking-widest text-primary bg-primary/10 px-3 py-1.5 rounded border border-primary/20 shadow-sm w-fit">
          {badge}
        </span>
      )}
      <h1 class="text-4xl sm:text-6xl font-black leading-tight tracking-tight text-white font-sans">
        {heading}
      </h1>
      <p class="text-neutral-300 text-sm sm:text-base leading-relaxed max-w-lg">
        {subtitle}
      </p>

      <!-- Checklist Bullets -->
      <ul class="space-y-3 pt-2 text-xs sm:text-sm font-bold text-neutral-200">
        {bullets.map((bullet) => (
          <li class="flex items-center gap-3">
            <span class="w-5 h-5 rounded-full bg-primary flex items-center justify-center text-[10px] font-black text-neutral-950 shrink-0 shadow border border-primary/20">
              &check;
            </span>
            {bullet}
          </li>
        ))}
      </ul>

      <!-- Primary Action Buttons -->
      <div class="pt-4 flex flex-wrap gap-4">
        <a
          href="#get-quote-form"
          class="inline-flex items-center justify-center px-7 py-3.5 bg-primary hover:bg-primary-hover text-neutral-950 text-xs sm:text-sm font-extrabold uppercase tracking-widest transition-all cursor-pointer shadow-md rounded border border-primary/20"
        >
          Get My Free Estimate
        </a>
        <a
          href={`tel:${businessData.phone.replace(/[^0-9+]/g, '')}`}
          class="inline-flex items-center justify-center px-7 py-3.5 border border-white hover:bg-white/10 text-white text-xs sm:text-sm font-extrabold uppercase tracking-widest transition-all cursor-pointer rounded"
        >
          Call {businessData.phone}
        </a>
      </div>
    </div>

    <!-- Right Column: Lead Form Card -->
    <div id="get-quote-form" class="lg:col-span-5 bg-white text-neutral-900 p-8 rounded-xl shadow-2xl border border-neutral-200/50 space-y-6 select-none scroll-mt-28">
      <div class="text-center space-y-1">
        <h3 class="text-lg font-black tracking-wider text-neutral-900 uppercase">{formTitle}</h3>
        <p class="text-[10px] font-bold text-neutral-400 uppercase tracking-widest">Takes under 60 seconds</p>
      </div>

      <form id="hero-quote-form" method="POST" action="https://api.web3forms.com/submit" class="space-y-4">
        <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
        <input type="hidden" name="subject" value={`New Estimate Request - ${businessData.name}`} />
        <input type="hidden" name="from_name" value={businessData.name} />
        <label class="hidden" aria-hidden="true">
          Leave this field blank
          <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
        </label>

        <div class="space-y-1 text-left">
          <label for="hero-form-name" class="text-[10px] font-black uppercase text-neutral-400 tracking-wider">Full Name</label>
          <input
            type="text"
            name="name"
            id="hero-form-name"
            required
            placeholder="John Doe"
            class="w-full px-4 py-2.5 bg-neutral-50 border border-neutral-200 focus:outline-none focus:border-primary text-xs sm:text-sm font-semibold text-neutral-900 rounded"
          />
        </div>

        <div class="space-y-1 text-left">
          <label for="hero-form-phone" class="text-[10px] font-black uppercase text-neutral-400 tracking-wider">Phone Number</label>
          <input
            type="tel"
            name="phone"
            id="hero-form-phone"
            required
            placeholder="(615) 555-5555"
            class="w-full px-4 py-2.5 bg-neutral-50 border border-neutral-200 focus:outline-none focus:border-primary text-xs sm:text-sm font-semibold text-neutral-900 rounded"
          />
        </div>

        <div class="space-y-1 text-left">
          <label for="hero-form-email" class="text-[10px] font-black uppercase text-neutral-400 tracking-wider">Email Address</label>
          <input
            type="email"
            name="email"
            id="hero-form-email"
            required
            placeholder="john@example.com"
            class="w-full px-4 py-2.5 bg-neutral-50 border border-neutral-200 focus:outline-none focus:border-primary text-xs sm:text-sm font-semibold text-neutral-900 rounded"
          />
        </div>

        <div class="space-y-1 text-left">
          <label for="hero-form-service" class="text-[10px] font-black uppercase text-neutral-400 tracking-wider">What do you need?</label>
          <select
            name="service_requested"
            id="hero-form-service"
            required
            class="w-full px-4 py-2.5 bg-neutral-50 border border-neutral-200 focus:outline-none focus:border-primary text-xs sm:text-sm font-semibold text-neutral-900 rounded"
          >
            <option value="" selected disabled>Select a service</option>
            {businessData.services.map((service: string) => (
              <option value={service}>{service}</option>
            ))}
          </select>
        </div>

        <div class="pt-2">
          <button
            type="submit"
            id="hero-form-submit"
            class="w-full py-3 bg-primary hover:bg-primary-hover text-neutral-950 text-xs sm:text-sm font-black uppercase tracking-widest rounded shadow-md border border-primary/20 cursor-pointer disabled:opacity-60 disabled:pointer-events-none"
          >
            <span data-submit-label>Get My Quote</span>
          </button>
        </div>
      </form>

      <p id="hero-form-feedback" class="hidden text-sm font-semibold text-center" role="status"></p>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('hero-quote-form') as HTMLFormElement | null;
  const feedback = document.getElementById('hero-form-feedback');
  const submitBtn = document.getElementById('hero-form-submit') as HTMLButtonElement | null;
  const submitLabel = submitBtn?.querySelector('[data-submit-label]');

  function setFeedback(message: string, isError: boolean) {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.classList.remove('hidden', 'text-red-600', 'text-primary');
    feedback.classList.add(isError ? 'text-red-600' : 'text-primary');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    if (submitLabel) submitLabel.textContent = 'Sending...';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const result = await response.json().catch(() => null);

      if (response.ok && result?.success) {
        form.reset();
        form.classList.add('hidden');
        setFeedback("Thanks - we've got your info and will be in touch shortly.", false);
      } else {
        throw new Error(result?.message || 'Submission failed');
      }
    } catch {
      setFeedback('Something went wrong. Please call us directly instead.', true);
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (submitLabel) submitLabel.textContent = 'Get My Quote';
    }
  });
</script>
