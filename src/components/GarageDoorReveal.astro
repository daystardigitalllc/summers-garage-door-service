---
// GarageDoorReveal.astro
// Wraps the hero in a scroll-driven garage door: the door starts fully
// closed over the hero, and scrolling raises it - like a real
// sectional door - to reveal the hero underneath. Once fully raised,
// the page continues scrolling normally past the hero.
//
// Built with a sticky-pin scrollytelling pattern (a tall wrapper with
// a position:sticky inner box) rather than scroll-jacking: no
// preventDefault, no wheel-event hijacking, so trackpad/touch/keyboard
// scrolling all keep working exactly as expected. A vanilla JS scroll
// listener just maps scroll position within the wrapper to the door's
// transform. Respects prefers-reduced-motion by skipping the door
// entirely and showing the hero right away.
---

<div id="garage-reveal-wrap" class="relative h-[260vh]">
  <div id="garage-reveal-pin" class="sticky top-0 h-[100vh] overflow-hidden bg-black">
    <div class="absolute inset-0 z-10">
      <slot />
    </div>

    <div id="garage-reveal-door" class="absolute inset-0 z-40 will-change-transform bg-[#0a0a0a]">
      <div class="relative h-full w-full flex flex-col">
        <!-- side rails -->
        <div class="pointer-events-none absolute inset-y-0 left-0 w-[3%] bg-gradient-to-r from-black to-transparent z-10"></div>
        <div class="pointer-events-none absolute inset-y-0 right-0 w-[3%] bg-gradient-to-l from-black to-transparent z-10"></div>

        <!-- row 1: windows -->
        <div class="relative flex-1 border-b border-black bg-gradient-to-b from-neutral-900 to-[#0a0a0a] shadow-[inset_0_2px_4px_rgba(255,255,255,0.08),inset_0_-6px_10px_rgba(0,0,0,0.6)]">
          <div class="absolute inset-0 flex items-center justify-center gap-[3%] px-[8%]">
            {Array.from({ length: 4 }).map(() => (
              <div class="h-[45%] flex-1 rounded-[2px] bg-gradient-to-br from-sky-200/30 via-slate-500/20 to-slate-900/40 border border-black shadow-[inset_0_1px_2px_rgba(255,255,255,0.25)]"></div>
            ))}
          </div>
        </div>

        <!-- row 2: raised long panels -->
        <div class="relative flex-1 border-b border-black bg-[#0a0a0a] grid grid-cols-2 gap-[2%] px-[3%] py-[6%]">
          <div class="rounded-[3px] border border-black shadow-[inset_0_2px_3px_rgba(255,255,255,0.10),inset_0_-4px_8px_rgba(0,0,0,0.7)] bg-gradient-to-b from-neutral-800 to-[#0a0a0a]"></div>
          <div class="rounded-[3px] border border-black shadow-[inset_0_2px_3px_rgba(255,255,255,0.10),inset_0_-4px_8px_rgba(0,0,0,0.7)] bg-gradient-to-b from-neutral-800 to-[#0a0a0a]"></div>
        </div>

        <!-- row 3: raised long panels -->
        <div class="relative flex-1 border-b border-black bg-[#0a0a0a] grid grid-cols-2 gap-[2%] px-[3%] py-[6%]">
          <div class="rounded-[3px] border border-black shadow-[inset_0_2px_3px_rgba(255,255,255,0.10),inset_0_-4px_8px_rgba(0,0,0,0.7)] bg-gradient-to-b from-neutral-800 to-[#0a0a0a]"></div>
          <div class="rounded-[3px] border border-black shadow-[inset_0_2px_3px_rgba(255,255,255,0.10),inset_0_-4px_8px_rgba(0,0,0,0.7)] bg-gradient-to-b from-neutral-800 to-[#0a0a0a]"></div>
        </div>

        <!-- row 4: raised long panels + threshold -->
        <div class="relative flex-1 bg-[#0a0a0a] grid grid-cols-2 gap-[2%] px-[3%] py-[6%]">
          <div class="rounded-[3px] border border-black shadow-[inset_0_2px_3px_rgba(255,255,255,0.10),inset_0_-4px_8px_rgba(0,0,0,0.7)] bg-gradient-to-b from-neutral-800 to-[#0a0a0a]"></div>
          <div class="rounded-[3px] border border-black shadow-[inset_0_2px_3px_rgba(255,255,255,0.10),inset_0_-4px_8px_rgba(0,0,0,0.7)] bg-gradient-to-b from-neutral-800 to-[#0a0a0a]"></div>
          <div class="pointer-events-none absolute bottom-0 inset-x-0 h-1 bg-primary/80"></div>
        </div>
      </div>

      <!-- logo decal, centered on the door -->
      <div class="pointer-events-none absolute inset-0 flex items-center justify-center z-20">
        <img
          src="/logo.png"
          alt="Summers Garage Door Service"
          class="w-40 sm:w-56 md:w-64 h-auto drop-shadow-[0_4px_16px_rgba(0,0,0,0.6)]"
        />
      </div>

      <!-- scroll hint -->
      <div id="garage-reveal-hint" class="absolute bottom-8 inset-x-0 z-20 flex flex-col items-center gap-2 text-white/70 transition-opacity duration-300 pointer-events-none">
        <span class="text-[11px] font-bold uppercase tracking-[0.3em]">Scroll to Open</span>
        <i class="fa-solid fa-chevron-down animate-bounce text-primary"></i>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const wrap = document.getElementById('garage-reveal-wrap');
    const door = document.getElementById('garage-reveal-door');
    const hint = document.getElementById('garage-reveal-hint');
    const header = document.getElementById('site-header');
    if (!wrap || !door) return;

    if (header) {
      header.style.transition = 'opacity 400ms ease';
    }

    function setHeaderVisible(visible: boolean) {
      if (!header) return;
      header.style.opacity = visible ? '1' : '0';
      header.style.pointerEvents = visible ? '' : 'none';
    }

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      door.style.display = 'none';
      setHeaderVisible(true);
      return;
    }

    // Nav stays hidden until the door has fully raised, so it doesn't
    // float on top of the closed door before there's a page to navigate.
    setHeaderVisible(false);

    // Scroll distance (as a fraction of one viewport height) needed to
    // fully raise the door. The wrapper is taller than this so the
    // door stays open and pinned for a beat before the page releases.
    const OPEN_VH = 100;

    let ticking = false;

    function update() {
      ticking = false;
      const rect = wrap.getBoundingClientRect();
      const viewportH = window.innerHeight;
      const openDistance = viewportH * (OPEN_VH / 100);
      const scrolled = -rect.top;
      const progress = Math.min(Math.max(scrolled / openDistance, 0), 1);
      door.style.transform = `translateY(${-progress * 100}%)`;
      if (hint) hint.style.opacity = String(Math.max(1 - progress * 6, 0));
      setHeaderVisible(progress >= 1);
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    // Links elsewhere on the site jump straight to the quote form
    // inside the hero (e.g. "/#get-quote-form"). Since that form only
    // becomes visible once the door is raised, force the door open and
    // land past it instead of dropping the visitor behind a closed door.
    function openForHash() {
      if (window.location.hash !== '#get-quote-form') return;
      // On mobile the form itself is hidden (it's a popup off the
      // bottom tab bar instead - see MobileTabBar.astro), so there's
      // nothing to scroll to; just open the door so the hero is visible.
      const isMobile = window.matchMedia('(max-width: 767px)').matches;
      const formVisible = !isMobile;
      const openDistance = window.innerHeight * (OPEN_VH / 100);
      window.scrollTo(0, wrap.offsetTop + openDistance + 1);
      door.style.transform = 'translateY(-100%)';
      if (hint) hint.style.opacity = '0';
      setHeaderVisible(true);
      if (!formVisible) {
        document.getElementById('mobile-quote-trigger')?.dispatchEvent(new Event('click'));
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    window.addEventListener('hashchange', openForHash);

    openForHash();
    update();
  })();
</script>
