---
import MainLayout from '../layouts/MainLayout.astro';
import businessData from '../data/business.json';
import contentData from '../data/content.json';

const reviews = contentData.reviews || [];
const googleUrl = 'https://www.google.com/maps/place/Summers+Garage+Door+Service/@33.5226069,-92.2827375,6z/data=!4m18!1m9!3m8!1s0x29f5ed6aa497d393:0x3db36ed7030a3062!2sSummers+Garage+Door+Service!8m2!3d33.5226069!4d-92.2827375!9m1!1b1!16s%2Fg%2F11rr699d29!3m7!1s0x29f5ed6aa497d393:0x3db36ed7030a3062!8m2!3d33.5226069!4d-92.2827375!9m1!1b1!16s%2Fg%2F11rr699d29';
---

<MainLayout
  title={`Testimonials & Reviews | ${businessData.name}`}
  description={`Read real reviews from Summers Garage Door Service customers across Middle & West Tennessee. Rated 5.0 on Google.`}
>
  <!-- Hero -->
  <section class="relative pt-32 pb-20 lg:pt-40 lg:pb-24 bg-black text-white overflow-hidden text-center">
    <div class="container mx-auto px-6 relative z-10 max-w-3xl space-y-6">
      <span class="text-xs font-bold uppercase tracking-wider text-primary bg-primary/10 px-3.5 py-1.5 rounded-full border border-primary/20">
        Testimonials
      </span>
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight uppercase leading-[1.1] text-white">
        What Our Customers Say
      </h1>
      <div class="flex items-center justify-center gap-3 pt-2">
        <span class="text-3xl font-extrabold text-white">5.0</span>
        <span class="text-accent text-2xl tracking-tight">★★★★★</span>
      </div>
      <p class="text-base sm:text-lg text-neutral-300 max-w-xl mx-auto leading-relaxed">
        Rated 5.0 from 38 reviews on Google. Here's a look at real feedback from homeowners across Middle & West Tennessee &mdash; view every review on our Google Business Profile.
      </p>
      <div class="pt-2">
        <a
          href={googleUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-bold uppercase tracking-widest border-2 border-white text-white hover:bg-white hover:text-black rounded-custom transition-all"
        >
          <i class="fa-brands fa-google"></i>
          See All 38 Reviews on Google
        </a>
      </div>
    </div>
  </section>

  <!-- Reviews Grid -->
  <section class="py-24 bg-neutral-900/40 relative border-t border-neutral-900/60">
    <div class="container mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {reviews.map((review) => (
          <div class="contractor-panel bg-white dark:bg-neutral-900 p-8 rounded-custom border border-neutral-200/50 dark:border-neutral-800/50 shadow-md flex flex-col justify-between space-y-6 transition-all hover:shadow-lg hover:-translate-y-1">
            <div class="space-y-3">
              <div class="flex text-accent text-lg">
                {Array.from({ length: review.rating }).map(() => (
                  <span>★</span>
                ))}
              </div>
              <p class="text-neutral-600 dark:text-neutral-300 text-sm leading-relaxed italic font-normal">
                "{review.text}"
              </p>
            </div>
            <div class="flex items-center justify-between gap-3 pt-4 border-t border-neutral-100 dark:border-neutral-900">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-extrabold text-sm shrink-0">
                  {review.author.charAt(0)}
                </div>
                <div>
                  <h4 class="font-bold text-sm text-black dark:text-white uppercase tracking-tight">{review.author}</h4>
                  <p class="text-xs text-neutral-400 dark:text-neutral-500 font-semibold">{review.location}</p>
                </div>
              </div>
              {review.date && (
                <span class="text-[11px] text-neutral-400 dark:text-neutral-600 font-semibold shrink-0">{review.date}</span>
              )}
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-16 space-y-4">
        <p class="text-neutral-400 text-sm">
          These are {reviews.length} of our 38 five-star Google reviews.
        </p>
        <a
          href={googleUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-bold uppercase tracking-widest bg-primary hover:bg-primary-hover text-white rounded-custom shadow-md shadow-primary/20 transition-all"
        >
          Read the Rest on Google
        </a>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="py-20 bg-black relative overflow-hidden">
    <div class="container mx-auto px-6 relative z-10">
      <div class="relative rounded-3xl overflow-hidden shadow-2xl bg-gradient-to-br from-primary via-neutral-900 to-black text-white p-8 md:p-16 text-center">
        <div class="max-w-2xl mx-auto space-y-6 relative z-10">
          <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight uppercase">
            Ready to Join Them?
          </h2>
          <p class="text-neutral-300 text-base sm:text-lg leading-relaxed">
            Get a free, no-pressure estimate from the same crew {reviews.length ? `${reviews.length}+ ` : ''}homeowners recommend across Middle & West Tennessee.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
            <a href="/#get-quote-form" class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-black bg-white hover:bg-neutral-100 rounded-custom shadow-lg transition-all hover:scale-103">
              {businessData.mainCta}
            </a>
            <a href={`tel:${businessData.phone}`} class="inline-flex items-center justify-center px-8 py-4 text-base font-bold border-2 border-white/20 hover:bg-white/10 rounded-custom transition-all gap-2">
              <i class="fa-solid fa-phone text-xs"></i> Call: {businessData.phone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
