---
import MainLayout from '../layouts/MainLayout.astro';
import contentData from '../data/content.json';

// Only the components this site actually renders (see content.json's
// "layout" array) - keeps the page free of the wider template
// library's unused imports.
import HeroContractor from '../components/HeroContractor.astro';
import GarageDoorReveal from '../components/GarageDoorReveal.astro';
import Marquee from '../components/Marquee.astro';
import TrustBar from '../components/TrustBar.astro';
import ServicesBento from '../components/ServicesBento.astro';
import StatCounters from '../components/StatCounters.astro';
import Gallery from '../components/Gallery.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
import FAQNumbered from '../components/FAQNumbered.astro';
import CTA from '../components/CTA.astro';

const ComponentMap: Record<string, any> = {
  Marquee,
  TrustBar,
  ServicesBento,
  StatCounters,
  Gallery,
  ServiceAreaMap,
  FAQNumbered,
  CTA,
};

// HeroContractor is rendered explicitly below, wrapped in the garage
// door scroll reveal, so it's excluded from the generic layout loop.
const layout: string[] = (contentData.layout || []).filter((name) => name !== 'HeroContractor');
---

<MainLayout>
  <GarageDoorReveal>
    <HeroContractor />
  </GarageDoorReveal>
  {layout.map((componentName) => {
    const Component = ComponentMap[componentName];
    if (!Component) {
      console.warn(`Component "${componentName}" was listed in layout but not found in ComponentMap.`);
      return null;
    }
    return <Component />;
  })}
</MainLayout>
