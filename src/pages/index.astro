---
import MainLayout from '../layouts/MainLayout.astro';
import contentData from '../data/content.json';

// Only the components this site actually renders (see content.json's
// "layout" array) - keeps the page free of the wider template
// library's unused imports.
import HeroContractor from '../components/HeroContractor.astro';
import Marquee from '../components/Marquee.astro';
import TrustBar from '../components/TrustBar.astro';
import ServicesBento from '../components/ServicesBento.astro';
import StatCounters from '../components/StatCounters.astro';
import Gallery from '../components/Gallery.astro';
import ReviewsMarquee from '../components/ReviewsMarquee.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
import FAQNumbered from '../components/FAQNumbered.astro';
import CTA from '../components/CTA.astro';

const ComponentMap: Record<string, any> = {
  HeroContractor,
  Marquee,
  TrustBar,
  ServicesBento,
  StatCounters,
  Gallery,
  ReviewsMarquee,
  ServiceAreaMap,
  FAQNumbered,
  CTA,
};

const layout: string[] = contentData.layout || [];
---

<MainLayout>
  {layout.map((componentName) => {
    const Component = ComponentMap[componentName];
    if (!Component) {
      console.warn(`Component "${componentName}" was listed in layout but not found in ComponentMap.`);
      return null;
    }
    return <Component />;
  })}
</MainLayout>
